{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window of WinTerm Bridge desktop client",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:event:default",
    "core:app:default",
    "core:webview:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://**" },
        { "url": "https://**" },
        { "url": "http://*/*" },
        { "url": "https://*/*" },
        { "url": "http://*:*" },
        { "url": "https://*:*" },
        { "url": "http://*:*/*" },
        { "url": "https://*:*/*" }
      ]
    },
    {
      "identifier": "websocket:default",
      "allow": [
        { "url": "ws://**" },
        { "url": "wss://**" },
        { "url": "ws://*/*" },
        { "url": "wss://*/*" },
        { "url": "ws://*:*" },
        { "url": "wss://*:*" },
        { "url": "ws://*:*/*" },
        { "url": "wss://*:*/*" }
      ]
    }
  ]
}
